# ============================================================
# Azure Entra ID Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.
# ============================================================

# Your Azure Entra ID tenant ID (Directory ID)
# Found in: Azure Portal → Entra ID → Overview → Tenant ID
AZURE_TENANT_ID=your-tenant-id-here

# The Application (client) ID from your App Registration
# Found in: Azure Portal → Entra ID → App registrations → Your app → Overview
AZURE_CLIENT_ID=your-client-id-here

# Object ID of the "api-readers" security group
# Found in: Azure Portal → Entra ID → Groups → api-readers → Object ID
AZURE_READER_GROUP_ID=your-reader-group-object-id-here

# Object ID of the "api-writers" security group
# Found in: Azure Portal → Entra ID → Groups → api-writers → Object ID
AZURE_WRITER_GROUP_ID=your-writer-group-object-id-here
